# Postgres connection (Supabase: Project settings > Database > connection string, use the pooler URL)
DATABASE_URL=postgres://user:pass@host:6543/postgres

# Long random string (e.g. `openssl rand -hex 32`). Signs logins and QR codes.
SESSION_SECRET=change-me-to-a-long-random-string


# Your password for /platform (add and manage businesses). At least 8 characters.
PLATFORM_ADMIN_PASSWORD=change-me-please

# Public URL of this app (used in WhatsApp messages and referral links)
APP_URL=https://rewards.example.com

# WhatsApp sender: dev (prints codes to the server log), fonnte, or meta
WHATSAPP_PROVIDER=dev
FONNTE_TOKEN=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_OTP_TEMPLATE=login_code
META_NUDGE_TEMPLATE=one_stamp_away
META_VOUCHER_TEMPLATE=voucher_expiring
META_REVIEW_TEMPLATE=review_request
META_TEMPLATE_LANG=en

# Protects the daily reminder job (Vercel sends this automatically as a Bearer token)
CRON_SECRET=change-me

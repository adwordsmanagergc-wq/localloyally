# Postgres connection (Supabase: Project settings > Database > connection string, use the pooler URL)
DATABASE_URL=postgres://user:pass@host:6543/postgres

# Long random string (e.g. `openssl rand -hex 32`). Signs logins and QR codes.
SESSION_SECRET=change-me-to-a-long-random-string


# Your password for /platform (add and manage businesses). At least 8 characters.
PLATFORM_ADMIN_PASSWORD=change-me-please

# Public URL of this app (used in WhatsApp messages and referral links)
APP_URL=https://loyallocally.com

# WhatsApp sender: dev (prints codes to the server log), fonnte, or meta
WHATSAPP_PROVIDER=dev
FONNTE_TOKEN=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_OTP_TEMPLATE=login_code
META_NUDGE_TEMPLATE=one_stamp_away
META_VOUCHER_TEMPLATE=voucher_expiring
META_REVIEW_TEMPLATE=review_request
META_OFFER_TEMPLATE=offer
META_TEMPLATE_LANG=en

# Protects the daily reminder job (Vercel sends this automatically as a Bearer token)
CRON_SECRET=change-me

# Apple Wallet (optional, see README). PEM text; \n instead of line breaks is fine.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=

# Google Wallet (optional, see README)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY=

# Free-week requests from the homepage are emailed here (via resend.com). Without a key they only show on /platform.
RESEND_API_KEY=
EMAIL_FROM=Loyal Locally <hello@loyallocally.com>
TRIAL_EMAIL_TO=aj@metatapdigital.com

# Phone notifications for members who add the card to their home screen. Make keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aj@metatapdigital.com
